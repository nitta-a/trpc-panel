{
  "name": "trpc-panel",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "test:panel": "yarn && npx nx test --project trpc-panel",
    "build:panel": "yarn && npx nx build --project trpc-panel",
    "build:test-app": "yarn && npx nx build --project test-trpc-panel",
    "build:docs": "yarn && npx nx build --project docs",
    "cpy:readme": "cp README.MD packages/trpc-panel/README.md",
    "start:test-app": "node ./packages/test-app/lib/server.js",
    "start:docs": "cd packages/docs && yarn serve",
    "lint": "npx @biomejs/biome check .",
    "format": "npx @biomejs/biome format --write .",
    "check": "npx @biomejs/biome check --write .",
    "typecheck": "yarn workspaces run typecheck"
  },
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@tsconfig/docusaurus": "^1.0.6",
    "nx": "22.7.10",
    "typescript": "^5.9.3"
  },
  "workspaces": {
    "packages": [
      "packages/trpc-panel",
      "packages/test-app",
      "packages/dev-app"
    ],
    "nohoist": [
      "**/zod-to-json-schema",
      "**/zod-to-json-schema/**"
    ]
  },
  "resolutions": {
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@adobe/css-tools": "^4.3.2",
    "@babel/core": "^7.29.1",
    "axios": "^1.20.0",
    "brace-expansion": "^5.0.9",
    "braces": "^3.0.3",
    "body-parser": "^2.3.0",
    "browserslist": "^4.28.9",
    "form-data": "^4.0.6",
    "devalue": "^5.9.3",
    "follow-redirects": "^1.16.1",
    "js-yaml@^3.13.1": "^3.15.2",
    "lodash": "^4.18.0",
    "micromatch": "^4.0.8",
    "minimatch@^3.0.4": "^3.1.4",
    "minimatch@^3.1.1": "^3.1.4",
    "minimatch@^5.0.1": "^5.1.8",
    "morgan": "^1.12.1",
    "next": "^15.5.27",
    "path-to-regexp": "^8.4.0",
    "picomatch": "^2.3.2",
    "postcss-selector-parser": "^7.1.6",
    "postcss": "^8.5.23",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.0",
    "serialize-javascript": "^7.1.2",
    "sharp": "^0.35.4",
    "smol-toml": "^1.7.1",
    "source-map-js": "^1.2.2",
    "svgo": "^2.8.4",
    "yaml": "^2.8.1"
  }
}
